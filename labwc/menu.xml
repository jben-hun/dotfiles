                ><action command="systemctl poweroff"
            /></item>
            <item label="reboot"><action command="systemctl reboot" /></item>
        </menu>
        <item label="reconfigure"><action name="Reconfigure" /></item>
        <item label="terminal"
            ><action name="Execute" command="lab-sensible-terminal"
        /></item>
    </menu>
