{
  "include": ["$HOME/.config/waybar/config-common.jsonc"],

  "modules-left": ["niri/window"],

  "niri/workspaces": {
    "workspace-taskbar": {
      "enable": true,
      "icon-size": 16,
    },
  },

  "niri/window": {
    "format": "{app_id}: {title}",
    "icon-size": 20,
    "on-scroll-up": "mmsg dispatch viewtoleft_have_client",
    "on-scroll-down": "mmsg dispatch viewtoright_have_client",
  },
}
