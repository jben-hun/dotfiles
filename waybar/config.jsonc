{
  "include": ["$HOME/.config/waybar/config-common.jsonc"],

  "modules-left": ["mango/workspaces", "mango/layout"],
  "modules-center": ["mango/window"],

  "mango/workspaces": {
    "hide-empty": true,
    "on-click": "activate",
  },

  "mango/window": {
    "format": "{app_id}: {title}",
    "icon-size": 20,
  },

  "mango/layout": {
    "format-T": "tile",
    "format-S": "scroller",
    "format-M": "monocle",
    "format-G": "grid",
    "format-K": "deck",
    "format-CT": "center_tile",
    "format-VT": "vertical_tile",
    "format-RT": "right_tile",
    "format-VS": "vertical_scroller",
    "format-VG": "vertical_grid",
    "format-VK": "vertical_deck",
    "format-DW": "dwindle",
    "format-F": "fair",
    "format-VF": "vertical_fair"
  },

  "mango/language": {
    "format": "{short}",
  },
}
