{
  "include": ["/home/jben/.config/waybar/config-common.jsonc"],
  "modules-left": ["ext/workspaces", "wlr/taskbar"],
  "modules-right": ["tray", "battery", "pulseaudio", "custom/pomo", "clock"],

  "ext/workspaces": {
    "format": "{name}",
    "sort-by-number": true,
    "on-click": "activate",
  },

  "wlr/taskbar": {
    "format": "{icon} {name}",
    "on-click": "activate",
    "tooltip-format": "{app_id}: {title}",
    "icon-theme": "Papirus-Dark",
  },
}
