// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "split",
  "languages": {
    "Markdown": {
      "show_edit_predictions": false,
      "format_on_save": "on",
    },
  },
  "cli_default_open_behavior": "existing_window",
  "edit_predictions": {
    "mode": "subtle",
    "provider": "copilot",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left",
  },
  "agent": {
    "flexible": false,
    "dock": "left",
    "default_profile": "write",
    "default_model": {
      "provider": "openai",
      "model": "gpt-5.6-terra",
      "enable_thinking": true,
      "effort": "medium",
    },
    "sidebar_side": "right",
    "favorite_models": [
      {
        "provider": "openai",
        "model": "gpt-5.6-terra",
        "enable_thinking": true,
        "effort": "medium",
      },
    ],
    "model_parameters": [],
  },
  "git_panel": {
    "tree_view": false,
    "dock": "left",
  },
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
  },
  "base_keymap": "Zed",
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Dark",
    "dark": "One Dark"
  },
  "terminal": {
    "env": {
      "GIT_EDITOR": "zed --wait"
    }
  }
}
