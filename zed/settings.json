// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "language_models": {
    "anthropic_compatible": {
      "Microsoft Foundry Anthropic": {
        "api_url": "https://azscaapdintwisdomaifdry.services.ai.azure.com/anthropic",
        "available_models": [
          {
            "name": "AAP-WISDOMAI-FDRY-CLAUDE-OPUS-5-5-WAI-DEVS",
            "max_tokens": 1000000,
            "capabilities": {
              "tools": true,
              "images": false,
              "prompt_caching": false,
            },
          },
        ],
      },
    },
    "openai_compatible": {
      "Microsoft Foundry OpenAI": {
        "api_url": "https://azscaapdintwisdomaifdry.services.ai.azure.com/api/projects/azscaapdintwisdomaifdry-project/openai/v1",
        "available_models": [
          {
            "name": "AAP-WISDOMAI-FDRY-GPT-6.1-SOL-WAI-DEVS",
            "max_tokens": 1050000,
            "reasoning_effort": "medium",
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": false,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false,
            },
          },
        ],
      },
    },
  },
  "buffer_font_family": "Lilex Nerd Font",
  "diff_view_style": "split",
  "languages": {
    "Markdown": {
      "show_edit_predictions": false,
      "format_on_save": "on",
    },
  },
  "cli_default_open_behavior": "existing_window",
  "edit_predictions": {
    "mode": "subtle",
    "provider": "copilot",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left",
  },
  "agent": {
    "sandbox_permissions": {
      "allow_all_hosts": true,
      "network_hosts": [
      ],
    },
    "tool_permissions": {
      "tools": {
        "search_web": {
          "default": "allow",
        },
        "fetch": {
          "default": "allow",
          "always_allow": [],
        },
      },
    },
    "flexible": false,
    "dock": "left",
    "default_profile": "minimal",
    "default_model": {
      "provider": "openai",
      "model": "gpt-5.6-terra",
      "enable_thinking": true,
      "effort": "medium",
    },
    "favorite_models": [
      {
        "provider": "openai",
        "model": "gpt-5.6-terra",
        "enable_thinking": true,
        "effort": "medium",
      },
    ],
    "model_parameters": [],
  },
  "git_panel": {
    "tree_view": false,
    "dock": "left",
  },
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "base_keymap": "Zed",
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "One Dark",
    "dark": "One Dark",
  },
  "terminal": {
    "env": {
      "GIT_EDITOR": "zed --wait",
    },
  },
}
